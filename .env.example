# 로컬 개발 환경변수 예시
# 처음 실행 시 scripts가 이 파일을 .env로 복사한다. .env는 Git에 올라가지 않는다.
# 로컬 전용 값이며 운영 비밀번호를 여기에 적지 말 것.

# PostgreSQL (docker compose) — 프로젝트 DB 포트는 5433
POSTGRES_DB=rentdb
POSTGRES_USER=rentdb
POSTGRES_PASSWORD=rentdb_local
DB_PORT=5433

# Mailpit (로컬 메일 확인)
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# 백엔드 / 프론트엔드 포트
SERVER_PORT=8080
FRONTEND_PORT=5173

# 첫 관리자 계정 — 관리자 계정이 하나도 없을 때 백엔드 시작 시 한 번만 생성된다.
# 이메일과 비밀번호(8자 이상)를 직접 입력한 뒤 백엔드를 재기동하세요. 생성 후에는 지워도 된다.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=관리자
